IF
	Global("Continuous_BG2_Nikita","MYAREA",0)
	OR(2)
		BeenInParty("CMNIKITA")
		Exists("CMNIKITA")
	!Dead("CMNIKITA")
//	!InPartyAllowDead("CMNIKITA")
//	!InParty("CMNIKITA")
//	!InMyArea("CMNIKITA")
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		ActionOverride("CMNIKITA",ChangeAIScript("cmnikita",OVERRIDE))
		SetGlobal("Continuous_BG2_Nikita","MYAREA",1)
		ActionOverride("CMNIKITA",SetGlobal("Continuous_BG2_Nikita","LOCALS",1))
		MoveGlobal("AR0406","CMNIKITA",[801.499])
		ApplySpellRES("bdresurr","CMNIKITA")
		SmallWait(1)
		ReallyForceSpellDeadRES("bdrejuve","CMNIKITA")
		ChangeEnemyAlly("CMNIKITA",NEUTRAL)
		ChangeSpecifics("CMNIKITA",ALLIES)
		ActionOverride("CMNIKITA",SetNumTimesTalkedTo(0))
//		ActionOverride("CMNIKITA",SetGlobal("bd_joined","locals",0)) // SoD
//		ActionOverride("CMNIKITA",ChangeAIScript("",CLASS))
//		ActionOverride("CMNIKITA",ChangeAIScript("",RACE))
//		ActionOverride("CMNIKITA",ChangeAIScript("",GENERAL))
//		ActionOverride("CMNIKITA",ChangeAIScript("",DEFAULT))
		ActionOverride("CMNIKITA",SetDialog("cmnikita"))
		GiveItemCreate("CMNIKRL1","cmnikita",0,0,0)
		GiveItemCreate("CMNIKRD1","cmnikita",0,0,0)
		GiveItemCreate("CMNIKRS1","cmnikita",0,0,0)
		GiveItemCreate("SW1H43","cmnikita",0,0,0)
		GiveItemCreate("CMNIKRX1","cmnikita",0,0,0)
		GiveItemCreate("BOLT02","cmnikita",40,0,0)
		GiveItemCreate("BOLT04","cmnikita",40,0,0)
		GiveItemCreate("BOLT04","cmnikita",40,0,0)
		GiveItemCreate("POTN17","cmnikita",5,0,0)
		GiveItemCreate("POTN10","cmnikita",5,0,0)
		GiveItemCreate("POTN52","cmnikita",5,0,0)
		ActionOverride("CMNIKITA",SetItemFlags("CMNIKRD1",IDENTIFIED,TRUE))
		ActionOverride("CMNIKITA",SetItemFlags("CMNIKRX1",IDENTIFIED,TRUE))
		ActionOverride("CMNIKITA",SetItemFlags("CMNIKRL1",IDENTIFIED,TRUE))
		ActionOverride("CMNIKITA",SetItemFlags("CMNIKRS1",IDENTIFIED,TRUE))
		%XEquipItem_dagger%
		%XEquipItem_armor%
		%XEquipItem_sword%
		SetInterrupt(TRUE)
		Continue()
END
